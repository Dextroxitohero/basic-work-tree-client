# Configuración pública del cliente. Sin secretos: se versiona.
#
# BANDERA: a qué API habla el cliente.
#   production -> la API de Railway
#   local      -> tu API en localhost
VITE_API_TARGET=production

# Las dos ligas
VITE_API_URL_LOCAL=http://localhost:8010
VITE_API_URL_PRODUCTION=https://basic-work-tree-api-production.up.railway.app
