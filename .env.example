# Para cambiar de API solo en tu máquina, crea .env.local (no se versiona) con la bandera:
#
#   VITE_API_TARGET=local        # tu API en localhost
#   VITE_API_TARGET=production   # la API de Railway (valor por defecto de .env)
#
# Las URLs de cada API están en .env. Una variable de entorno del sistema o de Railway
# tiene prioridad sobre estos archivos.
VITE_API_TARGET=production
